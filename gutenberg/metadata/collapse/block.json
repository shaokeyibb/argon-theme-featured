{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "argon/collapse",
  "title": "折叠区块",
  "category": "argon",
  "textdomain": "argon",
  "attributes": {
    "color": {
      "type": "string",
      "default": "#ffffff00"
    },
    "title": {
      "type": "string",
      "default": ""
