{
  "name": "argon-theme-featured",
  "version": "3.0.3",
  "private": true,
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "assets",
    "gutenberg"
  ],
  "scripts": {
    "build": "npm run build --workspaces && node scripts/licenses.mjs",
    "dev": "npm run dev --workspace assets",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:php": "node scripts/test-php.mjs",
    "test:package": "node scripts/test-package.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@playwright/test": "^1.64.1",
    "@wordpress/scripts": "^37.0.0",
    "@wp-playground/cli": "3.1.60",
    "archiver": "^8.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "postcss-selector-parser": "^7.1.7",
    "qs": "^6.16.1",
    "markdownlint-cli": {
      "js-yaml": "^5.5.0",
      "smol-toml": "^1.9.1"
    },
    "katex": "^0.19.0"
  }
}
