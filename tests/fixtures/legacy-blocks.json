  {
    "name": "argon/github",
    "html": "<!-- wp:argon/github {\"author\":\"WordPress\",\"project\":\"gutenberg\"} -->\n<div class=\"wp-block-argon-github github-info-card card shadow-sm github-info-card-full\" data-author=\"WordPress\" data-project=\"gutenberg\"><div class=\"github-info-card-header\"><a href=\"https://github.com/\" target=\"_blank\" title=\"Github\" rel=\"noopener\"><span><i class=\"fa-brands fa-github\"></i> GitHub</span></a></div><div class=\"github-info-card-body\"><div class=\"github-info-card-name-a\"><a href=\"https://github.com/WordPress/gutenberg\" target=\"_blank\" rel=\"noopener\"><span class=\"github-info-card-name\">WordPress/gutenberg</span></a></div><div class=\"github-info-card-description\"></div></div><div class=\"github-info-card-bottom\"><span class=\"github-info-card-meta github-info-card-meta-stars\"><i class=\"fa fa-star\"></i> <span class=\"github-info-card-stars\"></span></span><span class=\"github-info-card-meta github-info-card-meta-forks\"><i class=\"fa fa-code-fork\"></i> <span class=\"github-info-card-forks\"></span></span></div></div>\n<!-- /wp:argon/github -->"
  },
  {
    "name": "argon/timeline",
    "html": "<!-- wp:argon/timeline -->\n<div class=\"wp-block-argon-timeline\"><div class=\"argon-timeline\"><div class=\"argon-timeline-node\"><div class=\"argon-timeline-card card bg-gradient-secondary shadow-sm\"></div></div></div></div>\n<!-- /wp:argon/timeline -->"
  },
  {
    "name": "argon/progressbar",
    "html": "<!-- wp:argon/progressbar {\"title\":\"Legacy heading\"} -->\n<div class=\"progress-wrapper\" class=\"wp-block-argon-progressbar\"><div class=\"progress-info\"><div class=\"progress-label\"><span>Legacy heading</span></div><div class=\"progress-percentage\"><span>50%</span></div></div><div class=\"progress\"><div class=\"progress-bar\" style=\"width:50%;background-color:#7889e8\"></div></div></div>\n<!-- /wp:argon/progressbar -->"
  },
  {
