    "html": "<!-- wp:argon/collapse {\"title\":\"Legacy heading\",\"content\":\"Preserved \\u003cstrong\\u003e中文\\u003c/strong\\u003e content\",\"collapsed\":false} -->\n<div class=\"wp-block-argon-collapse collapse-block shadow-sm  hide-border-left\" style=\"border-left-color:#ffffff00\"><div class=\"collapse-block-title\" style=\"background-color:#ffffff00\"><span class=\"collapse-block-title-inner\">Legacy heading</span><i class=\"collapse-icon fa fa-angle-down\"></i></div><div class=\"collapse-block-body\" style=\"\">Preserved <strong>中文</strong> content</div></div>\n<!-- /wp:argon/collapse -->"
